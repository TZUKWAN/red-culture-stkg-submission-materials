# ---------------------------------------------------------------------------
# IMCR judge API credentials (GOAL.md section 19)
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit real keys: they must not appear in Python files, JSON, CSV,
# git history, logs, or the manuscript.  The code reads these variables via
# os.environ only (see code/independent_eval/judge_client.py).
#
# Each judge needs exactly three variables:
#   JUDGE_{NAME}_BASE_URL  OpenAI-compatible API base URL, e.g. https://api.example.com/v1
#   JUDGE_{NAME}_API_KEY   API key for that judge
#   JUDGE_{NAME}_MODEL     Exact model ID recorded in every call log
# ---------------------------------------------------------------------------

# Judge A (family 1)
JUDGE_A_BASE_URL=
JUDGE_A_API_KEY=
JUDGE_A_MODEL=

# Judge B (family 1 or 2)
JUDGE_B_BASE_URL=
JUDGE_B_API_KEY=
JUDGE_B_MODEL=

# Judge C (at least 2 distinct model families across A-E required)
JUDGE_C_BASE_URL=
JUDGE_C_API_KEY=
JUDGE_C_MODEL=

# Judge D (optional; required for the 5-judge panel)
JUDGE_D_BASE_URL=
JUDGE_D_API_KEY=
JUDGE_D_MODEL=

# Judge E (optional; required for the 5-judge panel)
JUDGE_E_BASE_URL=
JUDGE_E_API_KEY=
JUDGE_E_MODEL=
